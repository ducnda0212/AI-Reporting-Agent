# Sao chép thành server/.env rồi điền. KHÔNG đưa .env lên git, KHÔNG dán khoá vào chat.

# ===== Backend (DB, upload, kỳ báo cáo) =====
# DATABASE_URL=sqlite:///storage/pmo_reporting.db
# UPLOADS_DIR=storage/uploads
# Empty = active cycle follows today's date; set e.g. 2026_11_w3 to pin one
DEFAULT_CYCLE_ID=
AI_SERVICE_URL=http://localhost:8001/api/v1
MAX_UPLOAD_MB=50

# ===== Phần AI (app/ai) =====
# mock = chạy thử không gọi AI; vllm = gọi AI thật (nhà cung cấp chọn ở AI_PROVIDER ngay dưới)
AI_MODE=mock
# Nhà cung cấp khi AI_MODE=vllm: vllm = dùng khối VLLM_* | openai = dùng khối OPENAI_* (chat + embeddings đều đi OpenAI)
# Đổi qua lại chỉ cần sửa dòng này rồi restart; cấu hình của bên còn lại không bị đụng tới.
AI_PROVIDER=vllm

# --- OpenAI (dùng khi AI_PROVIDER=openai) ---
# Cảnh báo: chữ trong bảng (đã che tên người) được gửi sang OpenAI. Chỉ dùng với dữ liệu mẫu/giả cho tới khi infosec duyệt.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Model riêng cho Agent hỏi đáp. Để trống = dùng OPENAI_MODEL
OPENAI_AGENT_MODEL=
# Model embeddings cho RAG (tìm theo nghĩa)
OPENAI_EMBED_MODEL=text-embedding-3-small
# Chỉ đặt khi đi qua proxy; mặc định https://api.openai.com/v1
# OPENAI_BASE_URL=

# --- V-LLM (dùng khi AI_PROVIDER=vllm; chuẩn OpenAI /v1/chat/completions) ---
# Kết thúc bằng /v1, vd https://v-llm-core.uat.ntmh.vsf.services/<tenant>/v1
VLLM_BASE_URL=
# Đã đo: medium nhanh hơn nhiều, chất lượng đủ dùng (xem evals/DANH-GIA-AI.md)
VLLM_MODEL=v-llm-v1-medium
# Model riêng cho Agent hỏi đáp (cần nhanh). Để trống = dùng VLLM_MODEL
AGENT_MODEL=v-llm-v1-medium

# --- RAG cho Trợ lý hỏi đáp (tìm theo NỘI DUNG chữ trong bảng: tên, mục tiêu, báo cáo tuần, vướng mắc, comment) ---
# Luôn tìm theo từ khoá. Muốn tìm cả theo nghĩa: điền tên model embeddings của V-LLM (xem GET /api/ai/models). Để trống = chỉ từ khoá.
# (AI_PROVIDER=openai thì dùng OPENAI_EMBED_MODEL ở trên, bỏ qua các dòng AI_EMBED_* này.)
# Lưu ý: bật embeddings thì chữ trong bảng (đã che tên người) được gửi sang nhà cung cấp để tạo vector.
AI_EMBED_MODEL=
# Tắt hẳn embeddings dù đã có model: 0
AI_RAG_EMBEDDINGS=1
# Dịch vụ embeddings RIÊNG khi AI_PROVIDER=vllm mà tenant V-LLM chưa cấp model embeddings (vd OpenAI). Chỉ dùng với dữ liệu mẫu/giả.
# AI_EMBED_BASE_URL=https://api.openai.com/v1
# AI_EMBED_API_KEY=
# Nơi lưu vector đã tính để khởi động lại không phải nạp lại (không lưu chữ gốc). off = chỉ nhớ trong bộ nhớ
# AI_EMBED_CACHE=storage/embed_cache.db

# Cách 1: có sẵn token/API key do admin cấp (khối V-LLM)
VLLM_API_KEY=

# Cách 2: tự lấy token qua OAuth2 client credentials (để trống VLLM_API_KEY)
# vd https://<host>/oauth/token
VLLM_AUTH_URL=
VLLM_CLIENT_ID=
VLLM_CLIENT_SECRET=
VLLM_PROJECT_ID=

# Tắt chế độ "suy nghĩ" để trả lời nhanh và JSON sạch (0 = tắt, 1 = bật)
VLLM_THINKING=0
# Guardrail: để trống = theo mặc định của nền tảng; low | large | off
VLLM_GUARDRAIL=
# schema = response_format json_schema; object = json_object; none = chỉ dặn trong prompt
VLLM_JSON_MODE=schema
VLLM_MAX_TOKENS=2048
VLLM_TIMEOUT=90
# Áp dụng cho cả hai nhà cung cấp: VLLM_JSON_MODE, VLLM_MAX_TOKENS, VLLM_TIMEOUT, VLLM_CA_BUNDLE, VLLM_INSECURE
# Chứng chỉ nội bộ (nếu mạng công ty dùng CA riêng): đường dẫn file .pem
# VLLM_CA_BUNDLE=
# Chỉ dùng khi thử nghiệm: 1 = bỏ kiểm tra chứng chỉ (KHÔNG dùng thật)
VLLM_INSECURE=0

# Số dự án AI soạn song song
AI_CONCURRENCY=3
# Ẩn tên người trước khi gửi AI (1 = bật, khuyến nghị)
AI_MASK_NAMES=1
PORT=8000

# Nhận dạng giọng nói (nút mic). Mặc định dùng model ASR của V-LLM (AI_ASR_MODEL, mặc định v-llm-v1-asr).
# Nếu tài khoản V-LLM chưa có model giọng nói, có thể dùng dịch vụ riêng chuẩn /v1/audio/transcriptions, ví dụ Blaze.
# Đây là dịch vụ NGOÀI V-LLM: âm thanh câu hỏi (có thể có tên người, mã dự án) gửi ra ngoài. Chỉ dùng với dữ liệu demo cho tới khi infosec duyệt.
# AI_ASR_BASE_URL=https://api.blaze.vn/v1
# AI_ASR_API_KEY=
# AI_ASR_MODEL=blaze-stt-1.5
